# Core settings
WHATSAPP_PHONE=+1234567890
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://127.0.0.1:11434
DATABASE_URL=sqlite+aiosqlite:///./assistant.db
SESSION_SECRET=replace-with-strong-secret-min-32-chars
ADMIN_USERS=admin@example.com

# Administrator BCrypt password hash (separate from SESSION_SECRET)
# Generate via: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

APP_HOST=127.0.0.1
APP_PORT=8000
RATE_LIMIT_PER_MINUTE=60

# WhatsApp Bridge internal connection & shared authentication
WHATSAPP_BRIDGE_HOST=127.0.0.1
WHATSAPP_BRIDGE_PORT=3000
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000
WHATSAPP_BRIDGE_STORAGE=./storage/whatsapp_bridge
# Shared secret for internal bridge authentication header X-Bridge-Secret
WHATSAPP_BRIDGE_SECRET=replace-with-bridge-secret-min-32-chars

# Allowed CORS origins for web browser clients (comma-separated)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000

# Optional values
LOG_LEVEL=INFO

# Tool Execution Framework (Phase 4B)
ENABLE_TOOL_EXECUTION=true
TOOL_MAX_ROUNDS=3
TOOL_MAX_CALLS_PER_REQUEST=5
TOOL_TIMEOUT_SECONDS=15.0
TOOL_MAX_OUTPUT_CHARS=2000
ALLOW_EXTERNAL_NETWORK_TOOLS=false
TOOL_WORKSPACE_ROOT=./storage/workspace
TOOL_DEFAULT_PERMISSION_POLICY=standard

# Remote API Exposure Policy (Phase 5A)
# EDITH binds to loopback (127.0.0.1) by default. Non-loopback host addresses (e.g. 0.0.0.0)
# are rejected on startup unless ALLOW_REMOTE_API is explicitly set to true.
ALLOW_REMOTE_API=false

# CLI & Operator Client Environment Settings (Optional defaults for 'edith' CLI)
# EDITH_API_URL=http://127.0.0.1:8000
# EDITH_ADMIN_TOKEN=
# EDITH_ADMIN_USERNAME=
# EDITH_ADMIN_PASSWORD=

# Machine Chat API Keys (comma-separated list of authorized pre-shared keys for X-API-Key auth)
# API_KEYS=secret-api-key-1,secret-api-key-2
